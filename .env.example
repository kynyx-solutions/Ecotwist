VITE_SUPABASE_ANON_KEY="eyJ..."
import json
p='api/sitemap.js'; s=open(p).read()
def rep(a,b):
    global s; assert s.count(a)==1, a[:60]; s=s.replace(a,b)
rep("""  const postEntries = (await publishedPosts()).map((p) => {""","""  // Store product pages (src/content/store.json)
  let storeProducts = [];
  try {
    storeProducts = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'src/content/store.json'), 'utf8')).products.filter((p) => p.active);
  } catch (err) {
    console.error('[sitemap] could not read src/content/store.json', err);
  }
  const productEntries = storeProducts.map((p) => `  <url>
    <loc>${BASE_URL}/shop/${xmlEscape(p.id)}</loc>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>${p.image ? `\\n    <image:image>\\n      <image:loc>${BASE_URL}${xmlEscape(encodeURI(p.image))}</image:loc>\\n      <image:title>${xmlEscape(p.name)}</image:title>\\n    </image:image>` : ''}
  </url>`);

  const postEntries = (await publishedPosts()).map((p) => {""")
rep("${[...pageEntries, ...postEntries].join('\\n')}","${[...pageEntries, ...productEntries, ...postEntries].join('\\n')}")
open(p,'w').write(s)

p='vercel.json'; d=json.load(open(p)); d['functions']['api/sitemap.js']={"includeFiles":"src/content/{seo,store}.json"}
json.dump(d,open(p,'w'),indent=2); open(p,'a').write('\n')

p='src/content/seo.json'; s=open(p).read()
anchor='''      "focusKeyword": "channel partner gifts"
    }'''
assert s.count(anchor)==1
add=''',
    {
      "route": "/shop",
      "title": "Shop Sustainable Corporate Gifts Online",
      "description": "Order eco-friendly corporate gift kits online: cork, bamboo, soya wax and dry fruit hampers from 25 to 500+ kits, branded with your logo. Free mockup before you pay.",
      "image": "/kits/cork-diary-pen-flatlay.webp",
      "noindex": false,
      "focusKeyword": "buy corporate gifts online"
    },
    {
      "route": "/cart",
      "title": "Your Cart",
      "description": "Review your Ecotwist corporate gift order.",
      "image": "",
      "noindex": true,
      "focusKeyword": ""
    },
    {
      "route": "/order-placed",
      "title": "Order Placed",
      "description": "Thank you for your Ecotwist order.",
      "image": "",
      "noindex": true,
      "focusKeyword": ""
    }'''
s=s.replace(anchor, anchor+add); open(p,'w').write(s); json.load(open(p)); print('ok')
EOF
node -e "import('./api/sitemap.js').then(async m=>{const r={h:{},setHeader(k,v){},status(c){return r},send(b){console.log((b.match(/<url>/g)||[]).length,'urls;', (b.match(/\/shop\//g)||[]).length,'product urls')}};await m.default({}, r)})"

# Server only (api/*.js). Full database access: never commit it or share it.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Lead alert emails via Resend (https://resend.com). Optional: without these,
# leads are still saved but no email is sent.
RESEND_API_KEY="re_..."
ALERT_FROM_EMAIL="Ecotwist Leads <leads@ecotwist.in>"
# Sender for emails to clients (proposals, wishes); replies go to the staff member who sent it
MAIL_FROM="Ecotwist <hello@ecotwist.in>"

# Admin → SEO → Page speed. A Google Cloud API key with "PageSpeed Insights API"
# enabled (free). Without it Google rate-limits the checks almost at once.
PAGESPEED_API_KEY=""

# Online store payments (Razorpay Dashboard → Account & Settings → API keys).
# Server only: never expose the secret in the browser.
RAZORPAY_KEY_ID="rzp_live_..."
RAZORPAY_KEY_SECRET=""
# Razorpay Dashboard → Webhooks → URL https://ecotwist.in/api/store/razorpay-webhook,
# event "payment_link.paid"; paste the webhook secret you choose here.
RAZORPAY_WEBHOOK_SECRET=""
