# Copy to .env.local for local runs, and add the same names in Vercel →
# Project → Settings → Environment Variables for the live site.

# Supabase → Project Settings → API. The URL and anon key are safe in the browser.
VITE_SUPABASE_URL="https://xxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJ..."

# Server only (api/*.js). Full database access: never commit it or share it.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Lead alert emails via Resend (https://resend.com). Optional: without these,
# leads are still saved but no email is sent.
RESEND_API_KEY="re_..."
ALERT_FROM_EMAIL="Ecotwist Leads <leads@ecotwist.in>"
# Sender for emails to clients (proposals, wishes); replies go to the staff member who sent it
MAIL_FROM="Ecotwist <hello@ecotwist.in>"

# Admin → SEO → Page speed. A Google Cloud API key with "PageSpeed Insights API"
# enabled (free). Without it Google rate-limits the checks almost at once.
PAGESPEED_API_KEY=""
