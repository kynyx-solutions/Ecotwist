{
  "redirects": [
    {
      "source": "/configurator",
      "destination": "/get-proposal",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path((?!assets/).*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!api/|admin).*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/sitemap.js": {
      "includeFiles": "src/content/seo.json"
    }
  }
}
