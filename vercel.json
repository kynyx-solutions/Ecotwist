{
  "redirects": [
    {
      "source": "/configurator",
      "destination": "/get-proposal",
      "permanent": true
    },
    {
      "source": "/sitemap-blog.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/sitemap-pages.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path((?!assets/).*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!api/|admin).*)",
      "destination": "/app.html"
    }
  ],
  "functions": {
    "api/sitemap.js": {
      "includeFiles": "src/content/{seo,store}.json"
    },
    "api/store/order.js": {
      "includeFiles": "src/content/store.json"
    },
    "api/store/upload-url.js": {
      "includeFiles": "src/content/store.json"
    }
  },
  "cleanUrls": true
}
